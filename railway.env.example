# Railway Environment Variables Template
# Copy these variables to your Railway service environment settings

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.3

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_DB_PASSWORD=your_supabase_password

# Frontend Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Spider Crawler Configuration
SPIDER_API_KEY=your_spider_api_key

# System Configuration
ENVIRONMENT=production
LOG_LEVEL=INFO

# Railway will automatically set these:
# PORT=8000 (for backend)
# PORT=3000 (for frontend)

# Redis Configuration (use Railway Redis addon)
REDIS_URL=redis://railway-redis-url

# Frontend API URL (set to your backend Railway URL)
NEXT_PUBLIC_API_URL=https://your-backend-railway-url

# CORS Origins (include your frontend Railway URL)
FASTAPI_CORS_ORIGINS=["https://your-frontend-railway-url"]